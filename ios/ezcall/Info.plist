<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>EasyCall</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>EasyCall</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>app.xcall.relay.widget</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>app.xcall.relay.widget</string>
            </array>
        </dict>
    </array>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Connect to your Android and receive the calls, SMS, and contacts you share.</string>
    <key>NSCameraUsageDescription</key>
    <string>Scan the pairing code on your Android.</string>
    <key>NSContactsUsageDescription</key>
    <string>Show matching iPhone contacts as you enter a number on the EasyCall keypad.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Talk on calls that you answer or place through your Android.</string>
    <key>NSUserActivityTypes</key>
    <array>
        <string>INStartCallIntent</string>
        <string>INStartAudioCallIntent</string>
    </array>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
    </dict>
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
        <string>bluetooth-central</string>
        <string>fetch</string>
        <string>voip</string>
    </array>
    <key>BGTaskSchedulerPermittedIdentifiers</key>
    <array>
        <string>app.xcall.relay.refresh</string>
    </array>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>EzcallReviewAppID</key>
    <string>$(EZCALL_REVIEW_APP_ID)</string>
    <key>EzcallWidgetGroup</key>
    <string>group.$(EZCALL_BUNDLE_IDENTIFIER)</string>
</dict>
</plist>

