    "This removes the link and the synced calls, messages and contacts from this iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصال و تماس‌ها، پیام‌ها و مخاطبین همگام‌شده از این آیفون حذف می‌شوند."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُحذف الاقتران والمكالمات والرسائل وجهات الاتصال المتزامنة من هذا iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina de este iPhone la vinculación y las llamadas, los mensajes y los contactos sincronizados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action supprime de cet iPhone le jumelage ainsi que les appels, les messages et les contacts synchronisés."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem bağlantıyı ve eşitlenen aramaları, mesajları ve kişileri bu iPhone’dan siler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa azione rimuove da questo iPhone l’abbinamento e le chiamate, i messaggi e i contatti sincronizzati."
          }
        }
      }
