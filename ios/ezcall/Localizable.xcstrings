    "Allow camera access to scan the pairing code.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای اسکن کد جفت‌سازی، به دوربین دسترسی بدهید."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح للكاميرا بالوصول لفحص الرمز المزدوج."
          }
