    "Android could not confirm the SMS. Check Android before retrying.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ارسال پیامک تأیید نشد. پیش از تلاش دوباره گوشی فرستنده را بررسی کنید."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتمكن Android من تأكيد الرسائل القصيرة.تحقق من Android قبل الانسحاب."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Android no pudo confirmar el SMS. comprobar Android antes de retirarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android ne pouvait pas confirmer le SMS. vérifier Android avant le retrait."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android SMS'i doğrulayamadı. geri çekilmeden önce Android'i kontrol edin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Android non ha potuto confermare il SMS. Verificare Android prima di ritirarsi."
          }
        }
      }
    },
    "Android could not send the SMS. Check the SIM and permissions.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گوشی فرستنده نتوانست پیامک را بفرستد. سیم‌کارت و دسترسی‌ها را بررسی کنید."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتمكن Android من إرسال الرسائل القصيرة.تحقق من SIM والترخيص."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Android no pudo enviar el SMS. comprobar el SIM y las permisiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android ne pouvait pas envoyer le SMS. vérifier le SIM et les permissions."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android SMS'i gönderemez.SIM ve izinleri kontrol edin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Android non è stato in grado di inviare il SMS. verificare il SIM e le autorizzazioni."
          }
        }
      }
    },
    "Android couldn't answer the call. You can still answer on Android if it's ringing.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پاسخ از راه دور انجام نشد. اگر تماس هنوز زنگ می‌خورد، از گوشی فرستنده پاسخ دهید."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع أندرويد الرد على المكالمة.لا يزال بإمكانك الرد على أندرويد إذا كان يتصل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Android no pudo responder a la llamada. todavía puede responder en Android si está llamando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android ne pouvait pas répondre à l'appel. Vous pouvez toujours répondre sur Android si c'est appeler."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android çağrıya cevap veremedi. Android'de hala cevap verebilirsiniz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Android non riesce a rispondere alla chiamata. puoi ancora rispondere su Android se sta chiamando."
          }
        }
      }
    },
    "Android couldn't move call audio to the receiving phone. Use the sending phone.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اندروید نتوانست صدای تماس را به گیرنده منتقل کند. مکالمه را روی گوشی فرستنده ادامه دهید."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع أندرويد نقل المكالمات الصوتية إلى الهاتف المستلم."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Android no podía mover el audio de la llamada al teléfono receptor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
