          "stringUnit": {
            "state": "translated",
            "value": "اندروید نتوانست از میکروفون آیفون برای این تماس استفاده کند. با میکروفون گوشی اندرویدی صحبت کنید."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع أندرويد استخدام ميكروفون iPhone لهذا المكالمة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Android no podía usar el micrófono del iPhone para esta llamada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android ne pouvait pas utiliser le microphone de l'iPhone pour cette appel."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android bu çağrı için iPhone mikrofonu kullanamazdı."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Android non poteva usare il microfono iPhone per questa chiamata."
          }
        }
      }
    },
    "Android didn’t confirm the SMS. Check Android before retrying.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اندروید ارسال پیامک را تأیید نکرد. پیش از ارسال دوباره، گوشی اندرویدی را بررسی کنید."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أندرويد لم يؤكد الرسائل القصيرة.تحقق من أندرويد قبل الانسحاب."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Android no confirmó el SMS. comprobar Android antes de retirarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android n'a pas confirmé le SMS. vérifier Android avant le retrait."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Android SMS'i onaylamadı. geri çekilmeden önce Android'i kontrol edin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Android non ha confermato l'SMS. Controlla Android prima di ritirarsi."
          }
        }
      }
    },
    "Android didn’t finish sync. Previous items were kept.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اندروید همگام‌سازی را کامل نکرد. موارد قبلی حفظ شدند."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أندرويد لم تنته المزامنة.المواد السابقة تم الاحتفاظ بها."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Android no terminó la sincronización. los artículos anteriores fueron conservados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
