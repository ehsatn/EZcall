    "Turn on Call control and set up call audio in ezcall on your Android. Incoming calls use the iPhone call screen.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روی گوشی اندرویدی، در ایزی‌کال «کنترل تماس» را روشن کنید و صدای تماس را راه‌اندازی کنید. تماس‌های ورودی در صفحهٔ تماس آیفون نمایش داده می‌شوند."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتشغيل التحكم في المكالمات وتثبيت صوت المكالمات في ezcall على أندرويد."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descargue el control de llamadas y instale el audio de las llamadas en ezcall en su Android."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur le contrôle des appels et définissez l'audio des appels dans ezcall sur votre Android."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çağrı kontrolünü açın ve Android'inizde ezcall'de sesli çağrıları ayarlayın."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri il controllo delle chiamate e impostare l'audio delle chiamate in ezcall sul tuo Android."
          }
        }
      }
    },
