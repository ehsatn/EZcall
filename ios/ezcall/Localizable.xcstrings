    "Allow Send SMS from the receiving phone in ezcall on Android.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در ایزی کالِ گوشی فرستنده، ارسال پیامک از گوشی گیرنده را فعال کنید."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسمح بإرسال الرسائل القصيرة من الهاتف المستلم في ezcall على الروبوت."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite enviar SMS desde el teléfono receptor en ezcall en Android."
          }
        },
