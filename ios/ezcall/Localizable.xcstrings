    "Listen for the beeps, then speak to hear your voice back.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد از بوق‌ها صحبت کنید تا صدای خودتان را بشنوید."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استمع إلى الصفارات ثم تحدّث لسماع صدى صوتك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escucha los pitidos y luego habla para oír tu voz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écoutez les bips, puis parlez pour entendre votre voix."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ascolta i segnali, poi parla per sentire la tua voce."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bip seslerini dinleyin, ardından sesinizi duymak için konuşun."
          }
        }
      }
    },
    "I heard the beeps": {
      "extractionState": "manual",
