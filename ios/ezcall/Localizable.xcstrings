    "ezcall can notify you when your Android gets a call or SMS. SMS alerts show the sender and message according to your iPhone’s Show Previews setting.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ایزی‌کال می‌تواند دریافت تماس یا پیامک روی اندروید را به شما اطلاع دهد. نمایش فرستنده و متن در اعلان پیامک تابع تنظیم «نمایش پیش‌نمایش‌ها» در آیفون است."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ezcall يمكن إبلاغك عندما يتلقى جهاز Android مكالمة أو رسالة نصية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ezcall puede notificarle cuando su Android recibe una llamada o un SMS. los alertas de SMS muestran el remitente y el mensaje de acuerdo con la configuración de las previstas de su iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ezcall peut vous informer lorsque votre appareil Android reçoit un appel ou un SMS. les alertes SMS affichent l'envoi et le message selon les paramètres de l'affichage de votre iPhone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ezcall Android'inizin bir arama veya SMS aldığında sizi bilgilendirebilir. SMS uyarıları, iPhone'unuzun Gösterim Önizleme ayarlarına göre göndericiyi ve mesajı gösterir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ezcall può notificarti quando il tuo Android riceve una chiamata o un messaggio SMS. le notifiche SMS mostrano il messaggio e il messaggio in base alle impostazioni Show Preview del tuo iPhone."
          }
        }
      }
    },
    "ezcall is free. A tip is optional.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
