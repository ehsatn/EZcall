    },
    "Allow the microphone for ezcall in iPhone Settings to talk on calls.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای صحبت در تماس‌ها، در تنظیمات آیفون به ایزی‌کال دسترسی میکروفون بدهید."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمحوا على الميكروفون ezcall في إعدادات iPhone للتحدث عن المكالمات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que el micrófono para ezcall en la configuración de iPhone para hablar en las llamadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permettez au microphone pour ezcall dans les paramètres de l'iPhone de parler sur les appels."
          }
