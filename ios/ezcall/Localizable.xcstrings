    "Keep Bluetooth on and ezcall running on your Android. The phones reconnect automatically when they’re nearby.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بلوتوث و ایزی‌کال را روی گوشی اندرویدی روشن نگه دارید. وقتی گوشی‌ها نزدیک هم باشند، خودکار دوباره وصل می‌شوند."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحفاظ على بلوتوث وتشغيل ezcall على الروبوت الخاص بك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga Bluetooth en funcionamiento y ezcall en su Android. Los teléfonos se vuelven automáticamente cuando están cerca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez le Bluetooth en fonction et ezcall fonctionne sur votre Android. Les téléphones rejoignent automatiquement lorsqu'ils sont proches."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth'u çalıştırın ve Android'de ezcall çalıştırın. telefonlar yakınlarında otomatik olarak yeniden bağlanır."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenere il Bluetooth in esecuzione e ezcall in esecuzione su Android. i telefoni si riavviano automaticamente quando sono vicini."
          }
        }
      }
    },
    "Keep both phones nearby while they connect.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تا برقراری اتصال، هر دو گوشی را نزدیک هم نگه دارید."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ هاتين الهاتفين بالقرب بينما يتصلان."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener ambos teléfonos cerca mientras se conectan."
          }
        },
        "fr": {
