          }
        }
      }
    },
    "Allow the microphone so callers can hear you on calls you answer or place through your Android.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به میکروفون دسترسی بدهید تا در تماس‌هایی که از طریق اندروید پاسخ می‌دهید یا برقرار می‌کنید، طرف مقابل صدایتان را بشنود."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسمح الميكروفون بحيث يمكن للمتصلين الاستماع إليك على المكالمات التي تستجيب لها أو وضعها عبر Android الخاص بك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que el micrófono para que los llamadores puedan escuchar en las llamadas que responde o colocar a través de su Android."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez le microphone pour que les appels puissent vous entendre sur les appels que vous répondez ou placez à travers votre Android."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonu kullanın, böylece çağrıcılar size cevap verdiğiniz çağrılarda veya Android üzerinden yerleştirebilirsiniz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Permettere al microfono che gli chiamanti possano ascoltarti su chiamate che rispondi o posizionare attraverso il tuo Android."
          }
        }
      }
    },
