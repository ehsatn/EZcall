    },
    "Android didn’t respond. Looking for it again.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اندروید پاسخ نداد. دوباره در حال جست‌وجوی گوشی هستیم."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أندرويد لم يستجيب، بحثا عن ذلك مرة أخرى."
