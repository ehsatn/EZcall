    "Choose whether to keep calls, messages and contacts on this iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "انتخاب کنید سابقهٔ تماس‌ها، پیام‌ها و مخاطبان روی این آیفون بمانند یا حذف شوند."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر ما إذا كنت تريد الاحتفاظ بالمكالمات والرسائل وجهات الاتصال على هذا الـ iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige si quieres conservar las llamadas, los mensajes y los contactos en este iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez si vous souhaitez conserver les appels, messages et contacts sur cet iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli se conservare chiamate, messaggi e contatti su questo iPhone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aramaları, mesajları ve kişileri bu iPhone’da saklamak isteyip istemediğinizi seçin."
          }
        }
      }
    },
