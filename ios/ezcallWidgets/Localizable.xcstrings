    "Open the call history in ezcall.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تاریخچهٔ تماس‌ها را در ezcall باز کنید."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح سجل المكالمات في ezcall."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el historial de llamadas en ezcall."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez l’historique des appels dans ezcall."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arama geçmişini ezcall’da aç."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri la cronologia delle chiamate in ezcall."
          }
        }
      }
    },
    "Open your iPhone’s Messages app.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامهٔ پیام‌های آیفون را باز کنید."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح تطبيق الرسائل على iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la app Mensajes de tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez l’app Messages de votre iPhone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone’daki Mesajlar uygulamasını aç."
          }
        },
        "it": {
