    "Open ezcall’s call history or the iPhone’s Messages app.": {
      "extractionState": "manual",
      "localizations": {
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تاریخچهٔ تماس‌ها در ezcall یا برنامهٔ پیام‌های آیفون را باز کنید."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح سجل المكالمات في ezcall أو تطبيق الرسائل على iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el historial de llamadas de ezcall o la app Mensajes del iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez l’historique des appels d’ezcall ou l’app Messages de l’iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri la cronologia delle chiamate di ezcall o l’app Messaggi di iPhone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ezcall arama geçmişini veya iPhone’daki Mesajlar uygulamasını aç."
          }
        }
      }
    }
